# Facebook Page ID (numérico, ej: 123456789012345)
FB_PAGE_ID=

# Facebook Page Access Token (de GET /me/accounts, ~240 chars, empieza con EAA)
FB_ACCESS_TOKEN=your_page_token_here

# YouTube Channel ID (para cross-posting de Shorts)
YT_CHANNEL_ID=@JesusDailyShorts1

# Amazon Afiliados Tracking ID (opcional, para monetizar libros/biblias)
AMAZON_AFFILIATE_ID=

# Gumroad (para vender devocionales PDF)
GUMROAD_PRODUCT_ID=
